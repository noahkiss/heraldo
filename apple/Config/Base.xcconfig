// Shared by every target. Names come from Names.xcconfig; signing comes from
// the untracked Local.xcconfig (copy Local.example.xcconfig). With no
// Local.xcconfig the build signs ad hoc.

#include "Names.xcconfig"

MACOSX_DEPLOYMENT_TARGET = 15.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 5.0
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
// No get-task-allow in a release: notarization refuses it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

// The APNs environment the app's token belongs to: sandbox for a development
// build, production for TestFlight and the App Store.
APS_ENVIRONMENT = development
APS_ENVIRONMENT[config=Release] = production

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

APP_MAC_PROFILE =

// The Mac app's push, app group and synced Keychain need its Developer ID
// profile. Without one the Mac build keeps only the sandbox, and the
// credentials stay in this Mac's login keychain. Local.xcconfig switches both.
APP_MAC_ENTITLEMENTS = App/macOS/Unsigned.entitlements
APP_MAC_KEYCHAIN_GROUP =
// The share extension reads the same Keychain item, so it switches with the app.
APP_SHARE_MAC_ENTITLEMENTS = ShareExtension/ShareMacUnsigned.entitlements
APP_SHARE_MAC_PROFILE =
// A Developer ID profile carries production APNs only, in Debug too.
APS_ENVIRONMENT[sdk=macosx*] = production
// The widgets read the app group's snapshot and Keychain item. On iOS that is
// the app group; the Mac widget extension has no group, so its widgets are
// iOS-only for now.
APP_WIDGETS_GROUP =
APP_WIDGETS_GROUP[sdk=iphone*] = $(APP_GROUP_ID)
APP_IOS_PROFILE =
APP_NSE_IOS_PROFILE =
APP_WIDGETS_IOS_PROFILE =
APP_SHARE_IOS_PROFILE =

// HERALDO_CRITICAL_ALERTS (Names.xcconfig) picks the entitlements and the
// Swift condition. A signed Mac build sets APP_MAC_ENTITLEMENTS to
// $(APP_MAC_SIGNED_ENTITLEMENTS) in Local.xcconfig.
APP_IOS_ENTITLEMENTS_NO = App/iOS/App.entitlements
APP_IOS_ENTITLEMENTS_YES = App/iOS/AppCritical.entitlements
APP_IOS_ENTITLEMENTS = $(APP_IOS_ENTITLEMENTS_$(HERALDO_CRITICAL_ALERTS))
APP_MAC_SIGNED_ENTITLEMENTS_NO = App/macOS/App.entitlements
APP_MAC_SIGNED_ENTITLEMENTS_YES = App/macOS/AppCritical.entitlements
APP_MAC_SIGNED_ENTITLEMENTS = $(APP_MAC_SIGNED_ENTITLEMENTS_$(HERALDO_CRITICAL_ALERTS))
HERALDO_CRITICAL_SWIFT_CONDITION_NO =
HERALDO_CRITICAL_SWIFT_CONDITION_YES = HERALDO_CRITICAL_ALERTS
HERALDO_CRITICAL_SWIFT_CONDITION = $(HERALDO_CRITICAL_SWIFT_CONDITION_$(HERALDO_CRITICAL_ALERTS))

#include? "Local.xcconfig"
