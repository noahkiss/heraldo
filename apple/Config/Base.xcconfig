// Shared by every target. Names come from Names.xcconfig; signing comes from
// the untracked Local.xcconfig (copy Local.example.xcconfig). With no
// Local.xcconfig the build signs ad hoc.

#include "Names.xcconfig"

MACOSX_DEPLOYMENT_TARGET = 15.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 5.0
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
// No get-task-allow in a release: notarization refuses it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

APP_MAC_PROFILE =
APP_IOS_PROFILE =
APP_NSE_IOS_PROFILE =
APP_WIDGETS_IOS_PROFILE =

#include? "Local.xcconfig"
