# Copy to Local.env (untracked) for scripts/testflight.sh. Never commit Local.env.
# Each *_CMD is a shell command that prints the value, so no secret sits in a file.

# App Store Connect API key ID; Developer role is enough to upload.
ASC_KEY_ID=<KEY_ID>
# Prints the issuer ID.
ASC_ISSUER_CMD="<command that prints the issuer ID>"
# Prints the .p8 private key.
ASC_KEY_CMD="<command that prints the .p8 key>"
