{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noahkiss/heraldo/schema/envelope.v1.schema.json",
  "title": "Envelope",
  "description": "One heraldo event, envelope v1. The kind field picks the meaning of key and action. A sender may leave out id and ts; the server assigns them.",
  "type": "object",
  "required": [
    "source",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Server-assigned event id. Sortable by arrival.",
      "minLength": 1,
      "maxLength": 64
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the event happened, RFC 3339. The server uses the arrival time when it is missing."
    },
    "source": {
      "type": "string",
      "description": "The sender, such as a service or job name. One thread and icon per source by default.",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "incident",
        "digest",
        "progress",
        "checkin"
      ],
      "description": "What the event is. incident, progress and checkin need a key."
    },
    "key": {
      "type": "string",
      "description": "Groups related events: the incident, progress or check-in key. Maps to apns-collapse-id.",
      "maxLength": 64
    },
    "action": {
      "type": "string",
      "enum": [
        "open",
        "update",
        "ack",
        "resolve",
        "start",
        "end",
        "success",
        "fail",
        "log"
      ],
      "description": "Step within a kind. incident: open, update, ack, resolve. progress: start, update, end. checkin: start, success, fail, log. message and digest take none."
    },
    "title": {
      "type": "string",
      "maxLength": 256
    },
    "body": {
      "type": "string",
      "description": "Markdown. The server stores the full text; a push carries a truncated copy."
    },
    "level": {
      "type": "string",
      "enum": [
        "passive",
        "active",
        "time-sensitive",
        "critical"
      ],
      "default": "active",
      "description": "Interruption level. Maps to the APNs interruption-level."
    },
    "thread": {
      "type": "string",
      "description": "Notification thread. Maps to thread-id. Defaults to the source.",
      "maxLength": 128
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Opened when the notification is tapped."
    },
    "image": {
      "type": "string",
      "format": "uri",
      "description": "Image attached to the notification."
    },
    "icon": {
      "type": "string",
      "description": "Icon for the source: a URL or a symbol name.",
      "maxLength": 512
    },
    "actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Opened or called when the button is tapped."
          },
          "destructive": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "x-go-type-name": "ActionButton"
      }
    },
    "content": {
      "type": "object",
      "description": "Live Activity fields for kind progress.",
      "additionalProperties": true
    },
    "details": {
      "type": "object",
      "description": "Namespaced extras, such as {\"backup\": {\"bytes\": 1024}}.",
      "additionalProperties": true
    },
    "hold": {
      "type": "object",
      "description": "Triage state the server keeps for the event.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "incident"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "key"
        ],
        "properties": {
          "action": {
            "enum": [
              "open",
              "update",
              "ack",
              "resolve"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "progress"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "key"
        ],
        "properties": {
          "action": {
            "enum": [
              "start",
              "update",
              "end"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "checkin"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "key"
        ],
        "properties": {
          "action": {
            "enum": [
              "start",
              "success",
              "fail",
              "log"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "message",
              "digest"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "action"
          ]
        }
      }
    }
  ]
}
