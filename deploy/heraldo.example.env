# heraldo-server configuration. Copy to heraldo.env; never commit that file.

# Listen address inside the container, host:port.
HERALDO_ADDR=:7842

# SQLite database. /data is the image's volume.
HERALDO_DB=/data/heraldo.db

# Tokens, as "<name> <scope> <sha256> [capability]" entries separated by
# commas. scope is write, read or admin. trusted-ingest marks a bridge such as
# apprise-tee; notify-key lets a write token be the key in an Apprise URL,
# /notify/<token>; standby, on a read token, is a standby's token (see
# docs/api.md). Hash a token with:
#   heraldo-server hash-token < token.txt
# Or mount a file with one entry per line and set HERALDO_TOKENS_FILE instead.
HERALDO_TOKENS=example-sender write <sha256-of-the-sender-token>,example-reader read <sha256-of-the-reader-token>

# Ingest rules that type untyped inputs, those without kind (docs/api.md,
# "Ingest rules").
# Mount the file into the container and point at it. Unset: no rules.
#HERALDO_RULES=/config/rules.yaml

# APNs push. Off by default: the server registers devices and pushes nothing
# until HERALDO_PUSH=on. Give the .p8 auth key as a read-only mounted file or
# as its PEM text inline (one or the other), plus the key id and team id; or
# set none of them. A single-line inline key may write its line breaks as \n.
#HERALDO_PUSH=on
#HERALDO_APNS_KEY_FILE=/run/secrets/apns.p8
#HERALDO_APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#HERALDO_APNS_KEY_ID=<key-id>
#HERALDO_APNS_TEAM_ID=<team-id>

# Apprise senders that post with no credential: clients in these networks may
# use /notify/<key>, /v1/notify, /recent and the hold paths without a token.
# Read docs/api.md, "Sender auth", first. Unset: none.
#HERALDO_NOTIFY_TRUSTED_NETS=192.0.2.0/24

# The alert hold (docs/api.md, "Hold"): off, shadow or on. Mount the bypass
# list and point at it; deploy/hold-bypass.example.json shows the format.
#HERALDO_HOLD=shadow
#HERALDO_HOLD_BYPASS_FILE=/config/hold-bypass.json
#HERALDO_HOLD_DEADLINE=30m
#HERALDO_HOLD_DEADMAN=20m

# Standby: run this server as the standby of a primary on another host. It
# copies the primary's devices, pushes with its own APNs key while the
# primary is down, and hands its events back (docs/api.md, "Standby").
#HERALDO_ROLE=standby
#HERALDO_PRIMARY_URL=https://heraldo.example.net
#HERALDO_PRIMARY_TOKEN=<the standby's read token on the primary, with the standby capability>
#HERALDO_STANDBY_INTERVAL=1m
#HERALDO_PRIMARY_DOWN_AFTER=10m

# Server settings (docs/api.md, "Settings"). Every key has an env alias, such
# as HERALDO_QUIET_ENABLED for quiet.enabled. A key set here is locked: the
# API and the apps cannot change it. Leave a key unset to manage it with
# heraldo settings set. Every feature is off by default.
#HERALDO_QUIET_ENABLED=true
#HERALDO_QUIET_TZ=Europe/Paris
# Secrets written through the settings API, such as llm.token, are encrypted
# with this 32-byte key (openssl rand -hex 32). Unset: such writes are refused.
#HERALDO_SECRET_KEY_FILE=/run/secrets/heraldo-secret.key
# Or give the LLM token the APNs way: a mounted file, or inline.
#HERALDO_LLM_TOKEN_FILE=/run/secrets/llm.token
