# heraldo-server configuration. Copy to heraldo.env; never commit that file.

# Listen address inside the container, host:port.
HERALDO_ADDR=:7842

# SQLite database. /data is the image's volume.
HERALDO_DB=/data/heraldo.db

# Tokens, as "<name> <scope> <sha256>" entries separated by commas. scope is
# write, read or admin. Hash a token with: heraldo-server hash-token < token.txt
# Or mount a file with one entry per line and set HERALDO_TOKENS_FILE instead.
HERALDO_TOKENS=example-sender write <sha256-of-the-sender-token>,example-reader read <sha256-of-the-reader-token>
